+
+private final class ReusableViewIdentifier: Sendable {
+  private static let state = Mutex<(free: IndexSet, count: Int)>((free: IndexSet(), count: 0))
+
+  let index: Int
+  let string: String
+
+  init() {
+    index = Self.state.withLock { state in
+      if let index = state.free.first {
+        state.free.remove(index)
+        return index
+      }
+      state.count += 1
+      return state.count
+    }
+    string = String(index)
+  }
+
+  deinit {
+    Self.state.withLock { state in
+      _ = state.free.insert(index)
+    }
+  }
+}
