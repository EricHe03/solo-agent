+/// Rejects the numbers that `UInt64(_:)` traps on before a color is made from them.
+internal func checkColorNumbers(_ value: Any?, _ type: Any.Type) throws {
+  guard let value else {
+    return
+  }
+  switch value {
+  case let integer as Int:
+    if integer < 0 {
+      throw numberConversionException(integer, type)
+    }
+  case let number as Double:
+    if !(number >= 0 && number < 0x1p64) {
+      throw numberConversionException(number, type)
+    }
+  case let object as [String: Any]:
+    if let appearances = object["dynamic"] as? [String: Any] {
+      for appearance in appearances.values {
+        try checkColorNumbers(appearance, type)
+      }
+    }
+  default:
+    return
+  }
+}
