+  std::shared_ptr<EXRuntimeAccess> access;
+  {
+    std::lock_guard<std::mutex> lock(_runtimeMutex);
+    access = _runtimeAccess;
+  }
+  if (access != nullptr) {
+    terminate(access);
+  }
 }
 
