 #import <ReactCommon/RCTHost.h>
 #import <react/renderer/runtimescheduler/RuntimeSchedulerBinding.h>
 #import <ExpoModulesCore/EXReactSchedulerDispatch.h>
+#import <jsi/hermes-interfaces.h>
+#import <jsi/jsi.h>
+
+#import <memory>
+#import <mutex>
+
+// `RCTInstance` destroys its runtime on the JS thread, which never gets to it while JavaScript keeps
+// running. A Hermes timeout interrupts a single execution, and only code with async break checks,
+// which eval code has, so it is requested again until the runtime is gone.
+namespace {
+
+struct EXRuntimeAccess {
+  std::mutex mutex;
+  facebook::hermes::IHermes *hermes = nullptr;
+};
+
+struct EXRuntimeAccessOwner {
+  std::shared_ptr<EXRuntimeAccess> access;
+
+  explicit EXRuntimeAccessOwner(std::shared_ptr<EXRuntimeAccess> access) : access(std::move(access)) {}
+
+  ~EXRuntimeAccessOwner()
+  {
+    std::lock_guard<std::mutex> lock(access->mutex);
+    access->hermes = nullptr;
+  }
+};
+
+constexpr facebook::jsi::UUID runtimeAccessKey{0x2cb2ce3f, 0xa633, 0x41aa, 0xb595, 0xc4f00cf48af5};
+
+void terminate(std::shared_ptr<EXRuntimeAccess> access)
+{
+  {
+    std::lock_guard<std::mutex> lock(access->mutex);
+    if (access->hermes == nullptr) {
+      return;
+    }
+    access->hermes->asyncTriggerTimeout();
+  }
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+    terminate(access);
+  });
+}
+
+} // namespace
 
