    "Use this app on an iPhone or iPad to automate that device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استخدام هذا التطبيق على iPhone أو iPad لأتمتة ذلك الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте това приложение на iPhone или iPad, за да автоматизирате съответното устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো iPhone বা iPad অটোমেট করতে সেই ডিভাইসে এই অ্যাপটি ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza aquesta app en un iPhone o un iPad per automatitzar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li automatizovat iPhone nebo iPad, použijte tuto aplikaci přímo na něm."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug denne app på en iPhone eller iPad for at automatisere den enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende diese App auf einem iPhone oder iPad, um dieses Gerät zu automatisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε αυτήν την εφαρμογή σε iPhone ή iPad για να αυτοματοποιήσετε τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
