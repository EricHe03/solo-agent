    },
    "Automatic unlock supports English letters, numbers, spaces, and standard punctuation. Other characters aren’t supported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic unlock supports English letters, numbers, spaces, and standard punctuation. Other characters aren’t supported."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动解锁支持英文字母、数字、空格和常用英文标点，不支持其他字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動解鎖支援英文字母、數字、空格及常用英文標點，不支援其他字元。"
          }
        }
      }
    },
    "Automatic unlock supports passcodes up to 64 characters." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic unlock supports passcodes up to 64 characters."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动解锁支持最多 64 个字符的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動解鎖支援最多 64 個字元的密碼。"
          }
        }
      }
    },
    "Automating this iPad needs iPadOS 27 or later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب أتمتة جهاز iPad هذا نظام iPadOS 27 أو أحدث."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматизирането на този iPad изисква iPadOS 27 или по-нова версия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPad অটোমেট করতে iPadOS 27 বা তার পরের ভার্সন প্রয়োজন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per automatitzar aquest iPad, cal l’iPadOS 27 o posterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatizace tohoto iPadu vyžaduje iPadOS 27 nebo novější."
