            "value" : "આ ડિવાઇસને ઑટોમેટ કરવાનું ચાલુ રાખવા માટે Swiptને બૅકગ્રાઉંડમાં ચાલુ રહેવાની જરૂર છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להמשיך לבצע אוטומציה של המכשיר הזה, על Swipt להמשיך לפעול ברקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस को ऑटोमेट करते रहने के लिए Swipt को बैकग्राउंड में चालू रहना होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt mora ostati pokrenuta u pozadini kako bi nastavila automatizirati ovaj uređaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Swipt appnak a háttérben is futnia kell ahhoz, hogy továbbra is automatizálhassa az eszközt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
