        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы құрылғыны автоматтандыруды жалғастыру үшін Swipt фондық режимде жұмыс істеп тұруы керек."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನವನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸುವುದನ್ನು ಮುಂದುವರಿಸಲು, Swipt ಆ್ಯಪ್ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಯಲ್ಲಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기를 계속 자동화하려면 Swipt가 백그라운드에서 계속 실행되어야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
