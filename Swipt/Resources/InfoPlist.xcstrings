    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Swipt بخدمات المطور على هذا الجهاز، وإذا قمت بنشر واجهة API الخاصة به، فإنه يقبل الاتصالات على الشبكة المحلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt се свързва с услугите за разработчици на това устройство, а ако публикувате неговия API, приема и връзки от локалната мрежа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt এই ডিভাইসের ডেভেলপার পরিষেবাগুলির সাথে কানেক্ট করে, এবং আপনি এর API পাবলিশ করলে স্থানীয় নেটওয়ার্কে কানেকশন গ্রহণ করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt es connecta als serveis de desenvolupador d’aquest dispositiu i, si en publiques l’API, accepta connexions a la xarxa local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Swipt se připojuje k vývojářským službám na tomto zařízení, a pokud zveřejníte její API, přijímá i připojení z místní sítě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt opretter forbindelse til udviklertjenester på denne enhed og accepterer forbindelser på det lokale netværk, hvis du udgiver appens API."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt verbindet sich mit den Entwicklerdiensten auf diesem Gerät und nimmt Verbindungen im lokalen Netzwerk an, wenn du die API veröffentlichst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Swipt συνδέεται στις υπηρεσίες προγραμματιστή αυτής της συσκευής και, αν δημοσιεύσετε το API του, δέχεται συνδέσεις στο τοπικό δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt connects to developer services on this device and, if you publish its API, accepts connections on the local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se conecta a los servicios de desarrollador de este dispositivo y, si publicas su API, acepta conexiones en la red local."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se conecta a los servicios de desarrollador de este dispositivo y, si publicas su API, acepta conexiones en la red local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt muodostaa yhteyden tämän laitteen kehittäjäpalveluihin ja ottaa vastaan yhteyksiä lähiverkosta, jos julkaiset sen API:n."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se connecte aux services de développeur de cet appareil et, si vous publiez son API, accepte les connexions sur le réseau local."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt se connecte aux services de développeur de cet appareil et, si vous publiez son API, elle accepte les connexions sur le réseau local."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt આ ડિવાઇસ પરની ડેવલપર સેવાઓ સાથે કનેક્ટ થાય છે અને, જો તમે તેનું API પબ્લિશ કરો, તો સ્થાનિક નેટવર્ક પરનાં કનેક્શન સ્વીકારે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt מתחבר לשירותי המפתחים במכשיר הזה, ואם ה-API שלו מפורסם, הוא גם מקבל חיבורים ברשת המקומית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt इस डिवाइस पर डेवलपर सेवाओं से कनेक्ट होता है। अगर आप इसका API प्रकाशित करते हैं, तो यह स्थानीय नेटवर्क पर कनेक्शन भी स्वीकार करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt povezuje se s uslugama za programere na ovom uređaju, a ako objavite njezin API, prihvaća i veze s lokalne mreže."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Swipt az eszközön futó fejlesztői szolgáltatásokhoz csatlakozik, és ha Ön közzéteszi az API-ját, a helyi hálózatról érkező kapcsolatokat is fogad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt terhubung ke layanan pengembang di perangkat ini dan menerima koneksi di jaringan lokal jika Anda memublikasikan API-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt si connette ai servizi per sviluppatori su questo dispositivo e, se ne pubblichi l’API, accetta connessioni sulla rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiptは、このデバイス上のデベロッパサービスに接続します。また、APIを公開している場合は、ローカルネットワークからの接続を受け付けます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt осы құрылғыдағы әзірлеуші қызметтеріне қосылады, ал оның API интерфейсін жарияласаңыз, жергілікті желідегі қосылымдарды да қабылдайды."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ಆ್ಯಪ್ ಈ ಸಾಧನದಲ್ಲಿರುವ ಡೆವಲಪರ್ ಸೇವೆಗಳಿಗೆ ಕನೆಕ್ಟ್ ಆಗುತ್ತದೆ ಮತ್ತು ನೀವು ಅದರ API ಅನ್ನು ಪ್ರಕಟಿಸಿದರೆ, ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿನ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt는 이 기기의 개발자 서비스에 연결하며, 사용자가 API를 게시하는 경우 로컬 네트워크에서 들어오는 연결을 수락합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Swipt” jungiasi prie šiame įrenginyje veikiančių kūrėjo paslaugų, o jei paskelbsite programos API, priima ir ryšius iš vietinio tinklo."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ഈ ഡിവൈസിലെ ഡെവലപ്പർ സർവീസുകളിലേക്ക് കണക്റ്റ് ചെയ്യുന്നു. നിങ്ങൾ അതിന്റെ API പ്രസിദ്ധീകരിച്ചാൽ, ലോക്കൽ നെറ്റ്‌വർക്കിലെ കണക്ഷനുകളും സ്വീകരിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt या डिव्हाइसवरील डेव्हलपर सेवांशी कनेक्ट होते आणि तुम्ही त्याचे API प्रकाशित केल्यास स्थानिक नेटवर्कवरील कनेक्शन स्वीकारते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt menyambung ke perkhidmatan pembangun pada peranti ini dan, jika anda menerbitkan API-nya, menerima sambungan pada rangkaian setempat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt kobler til utviklertjenester på denne enheten og tar imot tilkoblinger på det lokale nettverket hvis du publiserer API-et."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt maakt verbinding met ontwikkelaarsdiensten op dit apparaat en accepteert verbindingen op het lokale netwerk als je de API publiceert."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ଏହି ଡିଭାଇସ୍‌ରେ ଥିବା ଡେଭଲପର୍ ସେବା ସହ ସଂଯୋଗ କରେ ଏବଂ ଯଦି ଆପଣ ଏହାର API ପ୍ରକାଶ କରନ୍ତି, ତେବେ ସ୍ଥାନୀୟ ନେଟ୍‌ୱର୍କ୍‌ରେ ସଂଯୋଗ ଗ୍ରହଣ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਡਿਵੈਲਪਰ ਸੇਵਾਵਾਂ ਨਾਲ ਕਨੈਕਟ ਕਰਦੀ ਹੈ। ਜੇ ਤੁਸੀਂ ਇਸਦਾ API ਪ੍ਰਕਾਸ਼ਿਤ ਕਰਦੇ ਹੋ, ਤਾਂ ਇਹ ਸਥਾਨਕ ਨੈੱਟਵਰਕ 'ਤੇ ਕਨੈਕਸ਼ਨ ਵੀ ਸਵੀਕਾਰ ਕਰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Swipt łączy się z usługami deweloperskimi na tym urządzeniu, a jeśli opublikujesz jej API, przyjmuje także połączenia z sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swipt se conecta aos serviços de desenvolvedor neste dispositivo e, se você publicar a API dele, aceita conexões na rede local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swipt liga‑se aos serviços de programador neste dispositivo e, se publicar a respetiva API, aceita ligações na rede local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația Swipt se conectează la serviciile pentru dezvoltatori de pe acest dispozitiv și, dacă publicați API-ul aplicației, acceptă conexiuni în rețeaua locală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt подключается к службам разработчика на этом устройстве и, если Вы опубликуете его API, принимает подключения из локальной сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka Swipt sa pripája k vývojárskym službám v tomto zariadení. Ak zverejníte jej API, prijíma aj pripojenia z lokálnej siete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt se povezuje s storitvami za razvijalce v tej napravi. Če objavite njen API, sprejema tudi povezave v lokalnem omrežju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ansluter till utvecklartjänster på den här enheten och tar emot anslutningar i det lokala nätverket om du publicerar dess API."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt இந்தச் சாதனத்தில் உள்ள டெவலப்பர் சேவைகளுடன் இணைகிறது. நீங்கள் அதன் APIஐ வெளியிட்டால், உள்ளக நெட்வொர்க்கில் இருந்து வரும் இணைப்புகளையும் ஏற்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ఈ డివైజ్‌లోని డెవలపర్ సర్వీస్‌లకు కనెక్ట్ అవుతుంది. మీరు దాని APIని పబ్లిష్ చేస్తే, లోకల్ నెట్‌వర్క్‌లోని కనెక్షన్‌లను కూడా అంగీకరిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt จะเชื่อมต่อกับบริการนักพัฒนาบนอุปกรณ์นี้ และหากคุณเผยแพร่ API ของ Swipt ก็จะยอมรับการเชื่อมต่อบนเครือข่ายในพื้นที่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt bu aygıttaki geliştirici servislerine bağlanır ve API’sini yayımlarsanız yerel ağdaki bağlantıları kabul eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма Swipt підʼєднується до служб розробника на цьому пристрої, а якщо ви опублікуєте її API, також приймає зʼєднання з локальної мережі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt اس ڈیوائس پر ڈیولپر سروسز سے کنکٹ ہوتا ہے، اور اگر آپ اس کا API شائع کرتے ہیں تو یہ مقامی نیٹ ورک پر کنکشنز بھی قبول کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt kết nối với các dịch vụ nhà phát triển trên thiết bị này và chấp nhận các kết nối trên mạng cục bộ nếu bạn công bố API của ứng dụng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 會連接此裝置上的開發者服務；如果你發佈其 API，它亦會接受來自本地網絡的連線。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 会连接此设备上的开发者服务；如果你发布它的 API，它还会接受本地网络上的连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 會連線至此裝置上的開發者服務；如果你發佈它的 API，它也會接受區域網路上的連線。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل Swipt على موقعك التقريبي فقط لمواصلة أتمتة هذا الجهاز أثناء استخدامك لتطبيقات أخرى أو عندما يكون الجهاز مقفلًا. ولا يحتفظ بموقعك ولا يرسله إلى أي مكان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt получава приблизителното Ви местоположение само за да продължи да автоматизира това устройство, докато използвате други приложения или устройството е заключено. Приложението не съхранява местоположението Ви и не го изпраща никъде."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অন্য অ্যাপ ব্যবহার করার সময় বা ডিভাইস লক থাকা অবস্থায় এই ডিভাইস অটোমেট করা চালু রাখার জন্যই শুধু Swipt-এ আপনার আনুমানিক লোকেশন নেওয়া হয়। আপনার লোকেশন সেভ করে রাখা বা কোথাও পাঠানো হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt obté la teva ubicació aproximada només per poder continuar automatitzant aquest dispositiu mentre utilitzes altres apps o mentre el dispositiu està bloquejat. No desa la ubicació ni l’envia enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Swipt zjišťuje vaši přibližnou polohu pouze proto, aby mohla dál automatizovat toto zařízení, když používáte jiné aplikace nebo je zařízení zamknuté. Vaši polohu neukládá ani ji nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt henter kun din omtrentlige lokalitet for at kunne fortsætte med at automatisere denne enhed, mens du bruger andre apps, eller mens enheden er låst. Lokaliteten bliver hverken gemt eller sendt nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ruft deinen ungefähren Standort nur ab, um dieses Gerät weiterhin zu automatisieren, während du andere Apps verwendest oder das Gerät gesperrt ist. Dein Standort wird weder aufbewahrt noch irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Swipt λαμβάνει την κατά προσέγγιση τοποθεσία σας μόνο για να συνεχίζει την αυτοματοποίηση αυτής της συσκευής ενώ χρησιμοποιείτε άλλες εφαρμογές ή όταν η συσκευή είναι κλειδωμένη. Δεν διατηρεί την τοποθεσία σας ούτε τη στέλνει πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
