        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swipt obtém a sua localização aproximada apenas para continuar a automatizar este dispositivo enquanto usa outras aplicações ou quando o dispositivo está bloqueado. A localização não é guardada nem enviada para lado nenhum."
          }
