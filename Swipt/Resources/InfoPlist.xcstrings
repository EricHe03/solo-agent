    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل Swipt على موقعك التقريبي فقط لمواصلة أتمتة هذا الجهاز أثناء استخدامك لتطبيقات أخرى أو عندما يكون الجهاز مقفلًا. ولا يحتفظ بموقعك ولا يرسله إلى أي مكان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt получава приблизителното Ви местоположение само за да продължи да автоматизира това устройство, докато използвате други приложения или устройството е заключено. Приложението не съхранява местоположението Ви и не го изпраща никъде."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অন্য অ্যাপ ব্যবহার করার সময় বা ডিভাইস লক থাকা অবস্থায় এই ডিভাইস অটোমেট করা চালু রাখার জন্যই শুধু Swipt-এ আপনার আনুমানিক লোকেশন নেওয়া হয়। আপনার লোকেশন সেভ করে রাখা বা কোথাও পাঠানো হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt obté la teva ubicació aproximada només per poder continuar automatitzant aquest dispositiu mentre utilitzes altres apps o mentre el dispositiu està bloquejat. No desa la ubicació ni l’envia enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Swipt zjišťuje vaši přibližnou polohu pouze proto, aby mohla dál automatizovat toto zařízení, když používáte jiné aplikace nebo je zařízení zamknuté. Vaši polohu neukládá ani ji nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt henter kun din omtrentlige lokalitet for at kunne fortsætte med at automatisere denne enhed, mens du bruger andre apps, eller mens enheden er låst. Lokaliteten bliver hverken gemt eller sendt nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ruft deinen ungefähren Standort nur ab, um dieses Gerät weiterhin zu automatisieren, während du andere Apps verwendest oder das Gerät gesperrt ist. Dein Standort wird weder aufbewahrt noch irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Swipt λαμβάνει την κατά προσέγγιση τοποθεσία σας μόνο για να συνεχίζει την αυτοματοποίηση αυτής της συσκευής ενώ χρησιμοποιείτε άλλες εφαρμογές ή όταν η συσκευή είναι κλειδωμένη. Δεν διατηρεί την τοποθεσία σας ούτε τη στέλνει πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt gets your approximate location only to keep automating this device while you use other apps or the device is locked. It doesn’t keep your location or send it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtiene tu ubicación aproximada solo para seguir automatizando este dispositivo mientras usas otras apps o el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtiene tu ubicación aproximada sólo para seguir automatizando este dispositivo mientras usas otras apps o cuando el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt hakee likimääräisen sijaintisi vain, jotta tämän laitteen automatisointi voi jatkua, kun käytät muita appeja tai laite on lukittuna. Se ei tallenna sijaintiasi eikä lähetä sitä minnekään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtient votre position approximative uniquement pour continuer à automatiser cet appareil lorsque vous utilisez d’autres apps ou que l’appareil est verrouillé. L’app ne conserve pas votre position et ne l’envoie nulle part."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt obtient votre position approximative uniquement pour continuer à automatiser cet appareil lorsque vous utilisez d’autres apps ou que l’appareil est verrouillé. Elle ne conserve pas votre position et ne l’envoie nulle part."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે અન્ય ઍપનો ઉપયોગ કરો અથવા ડિવાઇસ લૉક હોય ત્યારે આ ડિવાઇસને ઑટોમેટ કરવાનું ચાલુ રાખવા માટે જ Swipt તમારું અંદાજિત સ્થાન મેળવે છે. તે તમારું સ્થાન સાચવતું નથી કે ક્યાંય મોકલતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt מקבל את המיקום המשוער שלך רק כדי להמשיך לבצע אוטומציה של המכשיר הזה בזמן שימוש ביישומים אחרים או כשהמכשיר נעול. המיקום לא נשמר ולא נשלח לשום מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप अन्य ऐप्स का उपयोग करते हैं या डिवाइस लॉक होता है, तब इस डिवाइस को ऑटोमेट करते रहने के लिए ही Swipt आपकी अनुमानित लोकेशन प्राप्त करता है। यह आपकी लोकेशन न तो सहेजता है और न ही उसे कहीं भेजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt dohvaća vašu približnu lokaciju samo kako bi nastavila automatizirati ovaj uređaj dok upotrebljavate druge aplikacije ili je uređaj zaključan. Ne sprema vašu lokaciju niti je bilo kamo šalje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Swipt csak azért kéri le az Ön hozzávetőleges helyzetét, hogy továbbra is automatizálhassa az eszközt, amíg Ön más appokat használ, vagy az eszköz le van zárva. A helyadatokat nem tárolja, és sehová sem küldi el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt mendapatkan lokasi perkiraan Anda hanya untuk terus mengotomatiskan perangkat ini saat Anda menggunakan app lain atau saat perangkat terkunci. Swipt tidak menyimpan lokasi Anda atau mengirimkannya ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ottiene la tua posizione approssimativa solo per continuare ad automatizzare questo dispositivo mentre usi altre app o il dispositivo è bloccato. Non memorizza la tua posizione e non la invia da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiptは、ほかのアプリを使用しているときやデバイスがロックされているときにもこのデバイスの自動化を続けるためだけに、おおよその位置情報を取得します。位置情報を保存したり、どこかに送信したりすることはありません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt басқа қолданбаларды пайдаланып жатқанда немесе құрылғы құлыпталғанда осы құрылғыны автоматтандыруды жалғастыру үшін ғана шамамен орналасуыңызды алады. Ол орналасуыңызды сақтамайды және ешқайда жібермейді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಇತರ ಆ್ಯಪ್‌ಗಳನ್ನು ಬಳಸುತ್ತಿರುವಾಗ ಅಥವಾ ಸಾಧನ ಲಾಕ್ ಆಗಿರುವಾಗ ಈ ಸಾಧನವನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಮಾತ್ರ Swipt ಆ್ಯಪ್ ನಿಮ್ಮ ಅಂದಾಜು ಸ್ಥಳವನ್ನು ಪಡೆಯುತ್ತದೆ. ಇದು ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ ಅಥವಾ ಎಲ್ಲಿಗೂ ಕಳುಹಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt는 다른 앱을 사용하거나 기기가 잠겨 있는 동안에도 이 기기를 계속 자동화하기 위해서만 사용자의 대략적인 위치를 가져옵니다. 위치 정보를 보관하거나 다른 곳으로 전송하지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Swipt” nustato apytikslę jūsų vietovę tik tam, kad galėtų toliau automatizuoti šį įrenginį, kai naudojate kitas programas arba įrenginys užrakintas. Programa nesaugo jūsų vietovės ir niekur jos nesiunčia."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ മറ്റ് ആപ്പുകൾ ഉപയോഗിക്കുമ്പോഴോ ഡിവൈസ് ലോക്ക് ചെയ്തിരിക്കുമ്പോഴോ ഈ ഡിവൈസ് ഓട്ടോമേറ്റ് ചെയ്യുന്നത് തുടരാൻ മാത്രമാണ് Swipt നിങ്ങളുടെ ഏകദേശ ലൊക്കേഷൻ ലഭ്യമാക്കുന്നത്. ഇത് നിങ്ങളുടെ ലൊക്കേഷൻ സൂക്ഷിക്കുകയോ എവിടേക്കും അയയ്ക്കുകയോ ചെയ്യുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही इतर ॲप वापरत असताना किंवा डिव्हाइस लॉक असताना हे डिव्हाइस स्वयंचलित करत राहण्यासाठीच Swipt तुमचे अंदाजे स्थान मिळवते. ते तुमचे स्थान साठवत नाही किंवा कुठेही पाठवत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
