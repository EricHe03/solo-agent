    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Swipt بخدمات المطورين على هذا الجهاز ويخدم عملاء MCP على شبكتك المحلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt се свързва с услугите за разработчици на това устройство и обслужва MCP клиенти във Вашата локална мрежа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt এই ডিভাইসের ডেভেলপার পরিষেবাগুলোর সাথে কানেক্ট করে এবং আপনার লোকাল নেটওয়ার্কে MCP ক্লায়েন্টদের পরিষেবা দেয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt es connecta als serveis per a desenvolupadors d’aquest dispositiu i dona servei als clients MCP de la xarxa local."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Swipt se připojuje ke službám pro vývojáře na tomto zařízení a obsluhuje klienty MCP ve vaší místní síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt opretter forbindelse til udviklertjenester på denne enhed og betjener MCP-klienter på dit lokale netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt verbindet sich mit den Entwicklerdiensten dieses Geräts und stellt MCP-Clients in deinem lokalen Netzwerk einen Server bereit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Swipt συνδέεται στις υπηρεσίες προγραμματιστών αυτής της συσκευής και εξυπηρετεί πελάτες MCP στο τοπικό σας δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt connects to developer services on this device and serves MCP clients on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se conecta a los servicios para desarrolladores de este dispositivo y atiende a clientes MCP en tu red local."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se conecta a los servicios para desarrolladores de este dispositivo y atiende a clientes MCP en tu red local."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt muodostaa yhteyden tämän laitteen kehittäjäpalveluihin ja palvelee MCP-asiakkaita lähiverkossasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt se connecte aux services pour développeurs de cet appareil et dessert les clients MCP sur votre réseau local."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt se connecte aux services pour développeurs de cet appareil et dessert les clients MCP sur votre réseau local."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt આ ડિવાઇસ પરની ડેવલપર સેવાઓ સાથે કનેક્ટ થાય છે અને તમારા લોકલ નેટવર્ક પર MCP ક્લાયન્ટને સેવા આપે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt מתחבר לשירותי המפתחים במכשיר הזה ומשרת לקוחות MCP ברשת המקומית שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt इस डिवाइस की डेवलपर सेवाओं से कनेक्ट होता है और आपके लोकल नेटवर्क पर MCP क्लाइंट को सेवा देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt povezuje se s uslugama za razvojne programere na ovom uređaju i poslužuje MCP klijente na vašoj lokalnoj mreži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Swipt csatlakozik az eszköz fejlesztői szolgáltatásaihoz, és kiszolgálja a helyi hálózat MCP-klienseit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt terhubung ke layanan pengembang di perangkat ini dan melayani klien MCP di jaringan lokal Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt si connette ai servizi per sviluppatori di questo dispositivo e serve i client MCP sulla tua rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiptは、このデバイスのデベロッパサービスに接続し、ローカルネットワーク上のMCPクライアントにサービスを提供します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt осы құрылғыдағы әзірлеуші қызметтеріне қосылады және жергілікті желіңіздегі MCP клиенттеріне қызмет көрсетеді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ಈ ಸಾಧನದ ಡೆವಲಪರ್ ಸೇವೆಗಳಿಗೆ ಸಂಪರ್ಕಗೊಳ್ಳುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ MCP ಕ್ಲೈಂಟ್‌ಗಳಿಗೆ ಸೇವೆ ಒದಗಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt는 이 기기의 개발자 서비스에 연결하고 로컬 네트워크의 MCP 클라이언트에 서비스를 제공합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Swipt” prisijungia prie šio įrenginio kūrėjų paslaugų ir aptarnauja MCP klientus jūsų vietiniame tinkle."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ഈ ഡിവൈസിലെ ഡെവലപ്പർ സേവനങ്ങളിലേക്ക് കണക്റ്റ് ചെയ്യുകയും നിങ്ങളുടെ ലോക്കൽ നെറ്റ്‌വർക്കിലെ MCP ക്ലയന്റുകൾക്ക് സേവനം നൽകുകയും ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt या डिव्हाइसवरील डेव्हलपर सेवांशी कनेक्ट होते आणि तुमच्या लोकल नेटवर्कवरील MCP क्लायंटना सेवा देते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt bersambung ke perkhidmatan pembangun pada peranti ini dan melayani klien MCP pada rangkaian setempat anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt kobler til utviklertjenestene på denne enheten og betjener MCP-klienter på det lokale nettverket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt maakt verbinding met de ontwikkelaarsdiensten op dit apparaat en bedient MCP-clients op je lokale netwerk."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ଏହି ଡିଭାଇସ୍‌ର ଡେଭେଲପର୍ ସେବା ସହ ସଂଯୋଗ କରେ ଏବଂ ଆପଣଙ୍କ ଲୋକାଲ୍ ନେଟୱାର୍କରେ MCP କ୍ଲାଏଣ୍ଟମାନଙ୍କୁ ସେବା ପ୍ରଦାନ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ਇਸ ਡਿਵਾਈਸ ਦੀਆਂ ਡਿਵੈਲਪਰ ਸੇਵਾਵਾਂ ਨਾਲ ਕਨੈਕਟ ਹੁੰਦੀ ਹੈ ਅਤੇ ਤੁਹਾਡੇ ਸਥਾਨਕ ਨੈੱਟਵਰਕ 'ਤੇ MCP ਕਲਾਇੰਟਾਂ ਨੂੰ ਸੇਵਾ ਦਿੰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Swipt łączy się z usługami deweloperskimi tego urządzenia i obsługuje klientów MCP w Twojej sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swipt se conecta aos serviços para desenvolvedores deste dispositivo e atende clientes MCP na sua rede local."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Swipt liga-se aos serviços para programadores deste dispositivo e serve clientes MCP na sua rede local."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația Swipt se conectează la serviciile pentru dezvoltatori ale acestui dispozitiv și deservește clienții MCP din rețeaua locală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt подключается к службам разработчика на этом устройстве и обслуживает клиентов MCP в Вашей локальной сети."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka Swipt sa pripája k vývojárskym službám tohto zariadenia a obsluhuje klientov MCP vo vašej lokálnej sieti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt se poveže s storitvami za razvijalce v tej napravi in streže odjemalcem MCP v vašem lokalnem omrežju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ansluter till utvecklartjänsterna på den här enheten och betjänar MCP-klienter i ditt lokala nätverk."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt இந்தச் சாதனத்தின் டெவெலப்பர் சேவைகளுடன் இணைகிறது, மேலும் உங்கள் உள்ளூர் நெட்வொர்க்கில் உள்ள MCP கிளையன்ட்டுகளுக்குச் சேவை வழங்குகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ఈ డివైజ్‌లోని డెవలపర్ సర్వీస్‌లకు కనెక్ట్ అవుతుంది, మీ లోకల్ నెట్‌వర్క్‌లోని MCP క్లయింట్‌లకు సర్వీస్ అందిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt จะเชื่อมต่อกับบริการสำหรับนักพัฒนาบนอุปกรณ์นี้ และให้บริการไคลเอ็นต์ MCP บนเครือข่ายเฉพาะที่ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt, bu aygıttaki geliştirici hizmetlerine bağlanır ve yerel ağınızdaki MCP istemcilerine hizmet verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма Swipt підключається до служб для розробників на цьому пристрої та обслуговує клієнтів MCP у вашій локальній мережі."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt اس ڈیوائس پر ڈیولپر سروسز سے منسلک ہوتی ہے اور آپ کے مقامی نیٹ ورک پر MCP کلائنٹس کو سروس فراہم کرتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt kết nối với các dịch vụ dành cho nhà phát triển trên thiết bị này và phục vụ các ứng dụng khách MCP trên mạng cục bộ của bạn."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 會連線至此裝置上的開發者服務，並為你區域網路上的 MCP 用戶端提供服務。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 会连接此设备上的开发者服务，并为你本地网络上的 MCP 客户端提供服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt 會連線至此裝置上的開發者服務，並為你區域網路上的 MCP 用戶端提供服務。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل Swipt على موقعك التقريبي فقط لمواصلة أتمتة هذا الجهاز أثناء استخدامك لتطبيقات أخرى أو عندما يكون الجهاز مقفلًا. ولا يحتفظ بموقعك ولا يرسله إلى أي مكان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt получава приблизителното Ви местоположение само за да продължи да автоматизира това устройство, докато използвате други приложения или устройството е заключено. Приложението не съхранява местоположението Ви и не го изпраща никъде."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অন্য অ্যাপ ব্যবহার করার সময় বা ডিভাইস লক থাকা অবস্থায় এই ডিভাইস অটোমেট করা চালু রাখার জন্যই শুধু Swipt-এ আপনার আনুমানিক লোকেশন নেওয়া হয়। আপনার লোকেশন সেভ করে রাখা বা কোথাও পাঠানো হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt obté la teva ubicació aproximada només per poder continuar automatitzant aquest dispositiu mentre utilitzes altres apps o mentre el dispositiu està bloquejat. No desa la ubicació ni l’envia enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Swipt zjišťuje vaši přibližnou polohu pouze proto, aby mohla dál automatizovat toto zařízení, když používáte jiné aplikace nebo je zařízení zamknuté. Vaši polohu neukládá ani ji nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt henter kun din omtrentlige lokalitet for at kunne fortsætte med at automatisere denne enhed, mens du bruger andre apps, eller mens enheden er låst. Lokaliteten bliver hverken gemt eller sendt nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ruft deinen ungefähren Standort nur ab, um dieses Gerät weiterhin zu automatisieren, während du andere Apps verwendest oder das Gerät gesperrt ist. Dein Standort wird weder aufbewahrt noch irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Swipt λαμβάνει την κατά προσέγγιση τοποθεσία σας μόνο για να συνεχίζει την αυτοματοποίηση αυτής της συσκευής ενώ χρησιμοποιείτε άλλες εφαρμογές ή όταν η συσκευή είναι κλειδωμένη. Δεν διατηρεί την τοποθεσία σας ούτε τη στέλνει πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt gets your approximate location only to keep automating this device while you use other apps or the device is locked. It doesn’t keep your location or send it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtiene tu ubicación aproximada solo para seguir automatizando este dispositivo mientras usas otras apps o el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtiene tu ubicación aproximada sólo para seguir automatizando este dispositivo mientras usas otras apps o cuando el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt hakee likimääräisen sijaintisi vain, jotta tämän laitteen automatisointi voi jatkua, kun käytät muita appeja tai laite on lukittuna. Se ei tallenna sijaintiasi eikä lähetä sitä minnekään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt obtient votre position approximative uniquement pour continuer à automatiser cet appareil lorsque vous utilisez d’autres apps ou que l’appareil est verrouillé. L’app ne conserve pas votre position et ne l’envoie nulle part."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Swipt obtient votre position approximative uniquement pour continuer à automatiser cet appareil lorsque vous utilisez d’autres apps ou que l’appareil est verrouillé. Elle ne conserve pas votre position et ne l’envoie nulle part."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે અન્ય ઍપનો ઉપયોગ કરો અથવા ડિવાઇસ લૉક હોય ત્યારે આ ડિવાઇસને ઑટોમેટ કરવાનું ચાલુ રાખવા માટે જ Swipt તમારું અંદાજિત સ્થાન મેળવે છે. તે તમારું સ્થાન સાચવતું નથી કે ક્યાંય મોકલતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Swipt מקבל את המיקום המשוער שלך רק כדי להמשיך לבצע אוטומציה של המכשיר הזה בזמן שימוש ביישומים אחרים או כשהמכשיר נעול. המיקום לא נשמר ולא נשלח לשום מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप अन्य ऐप्स का उपयोग करते हैं या डिवाइस लॉक होता है, तब इस डिवाइस को ऑटोमेट करते रहने के लिए ही Swipt आपकी अनुमानित लोकेशन प्राप्त करता है। यह आपकी लोकेशन न तो सहेजता है और न ही उसे कहीं भेजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Swipt dohvaća vašu približnu lokaciju samo kako bi nastavila automatizirati ovaj uređaj dok upotrebljavate druge aplikacije ili je uređaj zaključan. Ne sprema vašu lokaciju niti je bilo kamo šalje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Swipt csak azért kéri le az Ön hozzávetőleges helyzetét, hogy továbbra is automatizálhassa az eszközt, amíg Ön más appokat használ, vagy az eszköz le van zárva. A helyadatokat nem tárolja, és sehová sem küldi el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt mendapatkan lokasi perkiraan Anda hanya untuk terus mengotomatiskan perangkat ini saat Anda menggunakan app lain atau saat perangkat terkunci. Swipt tidak menyimpan lokasi Anda atau mengirimkannya ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt ottiene la tua posizione approssimativa solo per continuare ad automatizzare questo dispositivo mentre usi altre app o il dispositivo è bloccato. Non memorizza la tua posizione e non la invia da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiptは、ほかのアプリを使用しているときやデバイスがロックされているときにもこのデバイスの自動化を続けるためだけに、おおよその位置情報を取得します。位置情報を保存したり、どこかに送信したりすることはありません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt басқа қолданбаларды пайдаланып жатқанда немесе құрылғы құлыпталғанда осы құрылғыны автоматтандыруды жалғастыру үшін ғана шамамен орналасуыңызды алады. Ол орналасуыңызды сақтамайды және ешқайда жібермейді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಇತರ ಆ್ಯಪ್‌ಗಳನ್ನು ಬಳಸುತ್ತಿರುವಾಗ ಅಥವಾ ಸಾಧನ ಲಾಕ್ ಆಗಿರುವಾಗ ಈ ಸಾಧನವನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಮಾತ್ರ Swipt ಆ್ಯಪ್ ನಿಮ್ಮ ಅಂದಾಜು ಸ್ಥಳವನ್ನು ಪಡೆಯುತ್ತದೆ. ಇದು ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ ಅಥವಾ ಎಲ್ಲಿಗೂ ಕಳುಹಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipt는 다른 앱을 사용하거나 기기가 잠겨 있는 동안에도 이 기기를 계속 자동화하기 위해서만 사용자의 대략적인 위치를 가져옵니다. 위치 정보를 보관하거나 다른 곳으로 전송하지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Swipt” nustato apytikslę jūsų vietovę tik tam, kad galėtų toliau automatizuoti šį įrenginį, kai naudojate kitas programas arba įrenginys užrakintas. Programa nesaugo jūsų vietovės ir niekur jos nesiunčia."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ മറ്റ് ആപ്പുകൾ ഉപയോഗിക്കുമ്പോഴോ ഡിവൈസ് ലോക്ക് ചെയ്തിരിക്കുമ്പോഴോ ഈ ഡിവൈസ് ഓട്ടോമേറ്റ് ചെയ്യുന്നത് തുടരാൻ മാത്രമാണ് Swipt നിങ്ങളുടെ ഏകദേശ ലൊക്കേഷൻ ലഭ്യമാക്കുന്നത്. ഇത് നിങ്ങളുടെ ലൊക്കേഷൻ സൂക്ഷിക്കുകയോ എവിടേക്കും അയയ്ക്കുകയോ ചെയ്യുന്നില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही इतर ॲप वापरत असताना किंवा डिव्हाइस लॉक असताना हे डिव्हाइस स्वयंचलित करत राहण्यासाठीच Swipt तुमचे अंदाजे स्थान मिळवते. ते तुमचे स्थान साठवत नाही किंवा कुठेही पाठवत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
